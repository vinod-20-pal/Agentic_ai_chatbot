{
  "name": "agentic-ai-chatbot-ts",
  "version": "1.0.0",
  "description": "TypeScript port of the LangGraph Agentic AI Chatbot (Express API + LangGraph.js ReAct agent + web frontend)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "backend": "tsx src/backend.ts",
    "dev": "tsx watch src/backend.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/backend.js"
  },
  "dependencies": {
    "@langchain/core": "0.3.72",
    "@langchain/groq": "0.2.3",
    "@langchain/langgraph": "0.4.9",
    "@langchain/openai": "0.6.9",
    "@langchain/tavily": "0.1.5",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
